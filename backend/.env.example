OPENAI_API_KEY=sk-your-key-here
TRANSCRIPTION_MODEL=gpt-4o-transcribe
TRANSCRIPTION_PROMPT=فقط گفتار انسانی فارسی را دقیق و با نگارش طبیعی پیاده‌سازی کن. موسیقی، سکوت، صدای محیط، افکت و برچسب‌هایی مثل Music را ننویس. نام اشخاص و مکان‌ها را تا حد ممکن درست بنویس.
APP_TOKEN=change-this-to-a-long-random-string
MAX_VIDEO_SECONDS=600
VAD_AGGRESSIVENESS=2
