OPENAI_API_KEY=sk-your-key-here
QUALITY_TRANSCRIPTION_MODEL=gpt-transcribe
TIMING_TRANSCRIPTION_MODEL=whisper-1
TRANSCRIPTION_PROMPT=گفتار فارسی را دقیق، روان و با نگارش طبیعی پیاده‌سازی کن. واژه‌های محاوره‌ای، نام اشخاص و مکان‌ها را حفظ کن. موسیقی، سکوت، صدای محیط و افکت را متن نکن.
APP_TOKEN=change-this-to-a-long-random-string
MAX_VIDEO_SECONDS=600
VAD_AGGRESSIVENESS=2
